# Docker Hub (non-secret)
DOCKERHUB_USERNAME=your_dockerhub_username

# Runtime configuration is stored outside Git.
# See aws/aws-setup.md for the recommended Secrets Manager setup.

# Backend
SPRING_DATASOURCE_URL=jdbc:mysql://your-rds-endpoint:3306/todo_db?useSSL=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=todo_app
SPRING_DATASOURCE_PASSWORD=change_me
COHERE_API_KEY=change_me
SLACK_WEBHOOK_URL=change_me
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Grafana is populated from AWS Secrets Manager during EC2 deployment.
GRAFANA_ADMIN_USER=admin
SPRING_JPA_HIBERNATE_DDL_AUTO=update
